# ------------------------------------------------------------------
# Root hardening (public_html). Blocks source, config and data files.
# ------------------------------------------------------------------
Options -Indexes
DirectoryIndex index.html Default.html index.php

# Dumps, logs, docs, configs and tooling files
<FilesMatch "(?i)(\.(sql|log|md|lock|ya?ml|ini|env|bak|old|orig|swp|dist)|^(php_errorlog|error_log|composer\.json|Dockerfile|docker-compose\.yml|\.gitignore|\.htaccess))$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Hidden folders (.git, .github), and backend internals that must never be served
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule ^api/(config|src|cron|storage)(/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Strict-Transport-Security "max-age=31536000"
    # Baseline CSP: blocks clickjacking, plugin content, <base> hijacking and forms posting to other sites
    Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
    Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>

# Internal panels must not appear in search engines
<IfModule mod_headers.c>
    <FilesMatch "^(admin-.*|employee-execution|login)\.html$">
        Header set X-Robots-Tag "noindex, nofollow"
    </FilesMatch>
</IfModule>
